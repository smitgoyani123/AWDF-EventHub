# ── Root-level Environment Variables ──
# Copy this file to .env and fill in the values

# Express server port
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/eventhub
# Docker: mongodb://mongo:27017/eventhub (set automatically in docker-compose)
MONGO_URI=mongodb://localhost:27017/eventhub

# Secret key used to sign JWT tokens (change in production!)
JWT_SECRET=eventhub_super_secret_key_2026
